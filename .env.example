# ==========================================================================
# 招投标智能问答机器人 —— 环境变量模板
# 用法：复制为 .env 后填入真实值。代码中不硬编码任何连接信息。
# ==========================================================================

# ---------------------------- MySQL（知识库数据源） ----------------------------
MYSQL_HOST=your-mysql-host
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=bidding_data
MYSQL_CHARSET=utf8mb4
MYSQL_CONNECT_TIMEOUT=10

# 参与建库的表（逗号分隔，按实际表名填写）
KB_TABLES=bidding_notices,bidding_project,companies
# 表的展示名（键=表名 值=中文名，逗号分隔）；未配置则直接显示表名
TABLE_LABELS=bidding_notices=招标公告,bidding_project=招投标项目,companies=公司信息

# 建库管道数据源：mysql（默认，行为不变）/ postgres（改读本机 PostgreSQL 副本，生产仍为 MySQL）
KB_SOURCE=mysql
# 无主键表的主键兜底声明（键=表名 值=列名，逗号分隔）；仅当 PG 表没有 PRIMARY KEY 约束时才生效
KB_PRIMARY_KEYS=

# ---------------------------- 向量库 Qdrant（双模式） ----------------------------
# 【二选一】QDRANT_URL 留空＝本地嵌入式（默认：离线可演示、数据不出本机、零运维）；
#           填了＝服务端模式（容器或云端），解除「同一目录只能一个进程」的限制。
# 本地模式示例：QDRANT_URL=（留空）     服务端示例：QDRANT_URL=http://127.0.0.1:16333
# 云端示例：QDRANT_URL=https://xxx.cloud.qdrant.io + QDRANT_API_KEY=...
# 注意：本地模式建库时要先停服务；用云托管时集群闲置会暂停、长期不激活会被删除。
QDRANT_PATH=./data/qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_TIMEOUT=30
QDRANT_PREFER_GRPC=false
QDRANT_COLLECTION=bidding_kb

# ---------------------------- 向量化模型 ----------------------------
EMBED_MODEL=BAAI/bge-small-zh-v1.5
EMBED_DIM=512
EMBED_BATCH_SIZE=32
# bge 中文模型推荐的查询前缀（只加在“问题”上，不加在文档上）；置空可关闭
EMBED_QUERY_PREFIX=为这个句子生成表示以用于检索相关文章：

# HuggingFace 模型下载源：国内网络建议走镜像；若报 401 / Xet 相关错误，保留下一行禁用 Xet
# （这两个键由 huggingface_hub 库直接读取，不经 app/config.py —— 是「config 不读」的唯一例外）
HF_ENDPOINT=https://hf-mirror.com
HF_HUB_DISABLE_XET=1

# ---------------------------- BM25 稀疏检索 ----------------------------
BM25_INDEX_PATH=./data/bm25_index.json
BM25_K1=1.5
BM25_B=0.75

# ---------------------------- 检索参数 ----------------------------
RETRIEVE_DENSE_TOP_K=10
RETRIEVE_SPARSE_TOP_K=10
RETRIEVE_FINAL_TOP_K=5
# RRF 融合常数，越小则排名靠前的结果权重越高
RRF_K=60
# 向量相似度门槛：低于该值且未被 BM25 命中的结果会被丢弃，避免无关内容混入（0=关闭过滤）
DENSE_MIN_SCORE=0.35
# 语义覆盖率闸门（与 DENSE_MIN_SCORE 并列的第二道判据）：
# 问题实词在检索块上的最大命中比例低于该值时不进入生成，返回「暂无明确依据」+ 排查建议
COVERAGE_MIN=0.45

# ---------------------------- 重排序（对 RRF 结果做大模型二次排序） ----------------------------
# RRF 融合后保留多少条候选交给大模型重排，重排后仍只取 RETRIEVE_FINAL_TOP_K 条送进回答
RERANK_CANDIDATES=10
# 留空则复用 LLM_MODEL。注意推理模型（如 DeepSeek v4-pro）思维链较慢，
# 重排这种简单排序任务建议填一个快模型，例如 deepseek-flash
RERANK_MODEL=
# 单个候选片段送进重排提示词的最大字符数
RERANK_MAX_CHARS=300
# 重排超时（秒）。推理模型思维链可能耗时较久，给太小会频繁回退到 RRF 顺序
RERANK_TIMEOUT=45
# 按需触发模式：auto（默认，满足触发条件才重排）/ always（一律重排）/ off（不重排）
RERANK_MODE=auto
# auto 触发条件①：头两名 dense 分数的相对差小于该值视为「并列难分」，触发重排
RERANK_AUTO_GAP=0.1
# auto 触发条件②：融合第一名的 dense 分低于该值（召回质量差）触发重排
RERANK_AUTO_MIN_DENSE=0.35

# ---------------------------- 文档切块 ----------------------------
# 单条记录文本超过该长度才切块
MAX_DOC_CHARS=1200
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------------------------- 大模型（OpenAI 兼容接口） ----------------------------
# 例：DeepSeek https://api.deepseek.com/v1  通义 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# 界面上「大模型」那一行显示的名字（仅用于展示）；留空则显示 LLM_MODEL
LLM_MODEL_DISPLAY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=60

# ---------------------------- Agent（把 RAG 检索注册成工具，由大模型自主决定是否调用） ----------------------------
# 留空则复用 LLM_MODEL。推理模型思维链较慢，可考虑填快模型（如 deepseek-flash）
AGENT_MODEL=
# Agent 单次大模型调用的输出上限。推理模型会先消耗思维链，给太小会导致正文为空
AGENT_MAX_TOKENS=2048
# 回传给 Agent 的历史轮数（一问一答算一轮）；0 = 不带历史
AGENT_HISTORY_TURNS=6
# Agent 最大步数（含工具调用），防止死循环
AGENT_MAX_STEPS=6
# 一轮里多个工具调用的最大并行数（asyncio.gather + 信号量限流；1 = 串行）
AGENT_TOOL_CONCURRENCY=3

# ---------------------------- PostgreSQL（与向量检索并行的结构化查询工具） ----------------------------
# 招投标明细数据（做统计/计数/求和/精确筛选），由 Agent 自主决定是否调用
PG_HOST=127.0.0.1
PG_PORT=5432
PG_USER=
PG_PASSWORD=
PG_DATABASE=chatbot
# 只查这个 schema
PG_SCHEMA=public
# 允许查询的表（逗号分隔）；留空 = PG_SCHEMA 下全部表
PG_TABLES=
PG_CONNECT_TIMEOUT=10
# 服务端语句超时（秒）。只读保护第 1 层，真正拦住写操作与慢查询
PG_STATEMENT_TIMEOUT=15
# 单次查询最多返回行数（同时作为强制 LIMIT）
PG_MAX_ROWS=50

# ---------------------------- PG 自然语言转 SQL ----------------------------
# 留空则复用 LLM_MODEL
PG_MODEL=
# 推理模型会先消耗思维链，给太小会导致正文为空（与重排同一教训）
PG_MAX_TOKENS=3072
PG_TIMEOUT=45
# schema 缓存秒数；结构变动后可等过期或用 /api/pg/schema?refresh=true
PG_SCHEMA_TTL=600

# ---------------------------- Neo4j 知识图谱（实体关系查询） ----------------------------
# 关系类问题（某公司中标了哪些项目 / 某项目有哪些参与单位）由 Agent 走图谱查询
# 连接地址二选一：
#   ① 本地 Neo4j：NEO4J_URI=bolt://127.0.0.1:7687（普通 bolt，无需 TLS）
#   ② Neo4j Aura 云服务：NEO4J_URI=neo4j+s://<实例ID>.databases.neo4j.io
#      （必须是 neo4j+s:// 带 TLS，不能写 bolt://）
# ⚠️ Aura 的用户名是「实例 ID」（URI 里那段十六进制），不是 neo4j；
#    库名 NEO4J_DATABASE 通常也是实例 ID（SHOW DATABASES 可查，未必叫 neo4j）。
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# 建连超时（秒）——只管「建立连接」与事务重试，不管一条查询能跑多久
NEO4J_TIMEOUT=30
# 单条查询的事务超时（秒）——服务端到点终止执行，真正限制查询时长；0 = 不限时
NEO4J_QUERY_TIMEOUT=30
# 单次图谱查询最多返回的行数（同时作为强制 LIMIT）
NEO4J_MAX_ROWS=50

# ---------------------------- 图谱自然语言转 Cypher ----------------------------
# 留空则复用 LLM_MODEL
GRAPH_MODEL=
# 推理模型会先消耗思维链，给太小会导致正文为空（与重排同一教训）
GRAPH_MAX_TOKENS=3072
GRAPH_TIMEOUT=45
# 图谱结构缓存秒数；结构变动后可等过期或用 /api/graph/schema?refresh=true
GRAPH_SCHEMA_TTL=600

# ---------------------------- 图片解析（智谱视觉模型） ----------------------------
# 智谱开放平台 API Key（https://open.bigmodel.cn/ 获取）；留空则 /analyze-image 返回 502
ZHIPUAI_API_KEY=
# 智谱 OpenAI 兼容端点：问答请求体带 model=glm-* 时切到此端点（需上一行的 Key，否则 400）
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# 视觉模型 id
VISION_MODEL=glm-4.6v-flashx
VISION_TIMEOUT=60
# 单张图片大小上限（字节）
VISION_MAX_BYTES=10485760

# ---------------------------- 联网搜索（Tavily） ----------------------------
# https://app.tavily.com/ 获取；留空则「联网搜索」工具不注册、前端开关置灰
TAVILY_API_KEY=
# basic（快） / advanced（更准、更慢）
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_TIMEOUT=20
# 「联网搜索」开关的前端默认值（true/false），前端每次请求可覆盖
WEB_SEARCH_DEFAULT=true

# ---------------------------- 对话历史（SQLite 本地持久化） ----------------------------
# 不用外部数据库：SQLite 零配置可写、单文件即备份（本地产物统一放 data/）
HISTORY_ENABLED=true
HISTORY_DB_PATH=./data/conversations.db
# 会话列表 / 搜索结果每页条数
HISTORY_PAGE_SIZE=20
HISTORY_SEARCH_LIMIT=20
# 自动生成会话标题时的最大字符数
HISTORY_TITLE_MAX_CHARS=30
# 单条消息落库的长度上限（防止超大写入）
HISTORY_MAX_MESSAGE_CHARS=20000

# ---------------------------- 账号体系（注册/登录/令牌） ----------------------------
# 关闭后所有 /api/history、/api/auth 端点返回 503，问答本身不受影响（仅不落库）
AUTH_ENABLED=true
# 令牌有效期（天）
AUTH_TOKEN_TTL_DAYS=30
# PBKDF2-HMAC-SHA256 迭代次数
AUTH_PBKDF2_ITERATIONS=200000
# 连续登录失败达到该次数后锁定
AUTH_MAX_LOGIN_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
# 管理员用户名白名单（逗号分隔）：名单内用户（或库里 role=admin 的用户）可访问后台用户管理
AUTH_ADMIN_USERS=

# ---------------------------- 问答缓存 / 指标 / 日志（本地 SQLite 与日志文件） ----------------------------
# 问答缓存库路径（相对项目根；回答按问题+参数缓存，知识库版本变化自动失效）
CACHE_DB_PATH=./backend/data/answer_cache.db
# 缓存有效期（秒）：超过后查询时按「未命中」处理
CACHE_TTL=3600
# 问答指标库路径（耗时、命中率等统计数据）
METRICS_DB_PATH=./backend/data/metrics.db
# 日志级别（DEBUG / INFO / WARNING / ERROR）
LOG_LEVEL=INFO
# 日志文件路径（按天轮转，轮转点为 UTC 午夜，保留 7 份）
LOG_FILE_PATH=./backend/data/app.log

# ---------------------------- 数据边界闸门（数据能力口径） ----------------------------
# 数据能力口径文件：记录数 / 字段缺失率 / 时间范围 / 图谱覆盖范围，ingest 结束时自动重算写回。
# 问答最前面先拿它判一次「这问题数据根本不覆盖吗」，命中就直接拒答（不检索、不调模型）。
# 该文件缺失或读不过时闸门降级为「不拦截」——绝不会因为缺一个文件就把问题拒掉。
DATA_CAPABILITY_PATH=./backend/app/data_capability.yaml

# ---------------------------- 应用层限流（内存令牌桶） ----------------------------
# 单个「IP + 用户」桶的容量：瞬时突发上限（首次访问直接给满一桶）
RATELIMIT_CAPACITY=10
# 每秒补充的令牌数：0.5 = 每 2 秒回 1 枚（稳态约 30 次/分钟；超限返回 429 + Retry-After）
RATELIMIT_REFILL_PER_SEC=0.5

# ---------------------------- 跨域（CORS） ----------------------------
# 允许跨域调用本 API 的前端来源（逗号分隔）。前端与后端端口不同即跨域，需显式放行。
# 默认只允许本机前端的两个地址；生产部署时改成真实域名。
# 【注意】不要再写 *，那等于放行任意网站，等于给接口门户大开。
CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# ---------------------------- 深度推理模式（Plan-and-Solve + Reflection） ----------------------------
# 规划阶段最多拆出多少个子任务
DEEP_MAX_STEPS=4
# 每个子任务内部 ReAct 循环的最大步数（langgraph 递归上限按「超步」计数：
# 一轮「模型→工具→模型」占 3 步，两次工具调用就占 5 步；给小了子任务会在
# 产出结论前被 Recursion limit 中断，该步直接失败。与 AGENT_MAX_STEPS 取齐）
DEEP_STEP_MAX_STEPS=6
# Reflection 自评迭代轮数（1 = 最多修订一次）
DEEP_REFLECT_ROUNDS=1
# 规划/自评/综合三个阶段的输出上限；推理模型会先消耗思维链，给小了正文会为空
DEEP_MAX_TOKENS=3072
# 深度模式整体超时（秒）
DEEP_TIMEOUT=120
# 单个子任务观察结果截断字符数（进 solve 上下文）
DEEP_OBSERVATION_CHARS=1200
# 预算四本账：工具调用 / 检索 / 大模型调用 各自的次数上限（<=0 表示该本账不限次）。
# 任何一本账超限都立即收敛到已有证据作答（不抛异常、不空手结束）；时间账见 DEEP_TIMEOUT。
DEEP_TOOL_CALL_LIMIT=12
DEEP_RETRIEVAL_LIMIT=8
DEEP_LLM_CALL_LIMIT=10
