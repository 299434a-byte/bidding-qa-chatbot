# ==========================================================================
# 招投标智能问答机器人 —— .gitignore
# --------------------------------------------------------------------------
# 本文件只决定「哪些文件不进版本库」，不参与任何业务逻辑。
# 唯一原则：凡是「能用一条命令重新生成的」或「含有密钥/口令的」，一律不提交。
# ==========================================================================

# ---------------------------- Python ----------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# 覆盖率报告（每次跑 pytest 都会重建，不入库）
.coverage
htmlcov/

# ---------------------------- Node / Next.js ----------------------------
node_modules/
frontend/node_modules/
frontend/.next/
frontend/out/
# Next.js 自动生成的类型声明文件，每次 build/dev 都会重建，不入库
frontend/next-env.d.ts
*.tsbuildinfo

# ---------------------------- 环境变量（含口令与 API Key，绝不入库） ----------------------------
.env
.env.local
.env.*.local

# ---------------------------- 运行时产物（可重新生成，且体积较大） ----------------------------
# 向量库（嵌入式 Qdrant 数据目录）
data/qdrant/
# BM25 索引（由建库命令生成）
data/bm25_index.json
# 知识库版本指纹（每次建库成功后重写，可由 python -m app.ingest 随时再生成）
data/kb_version.txt
# SQLite 对话历史库
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
# 长期记忆画像（按用户从对话里沉淀的 JSON，含用户数据，运行时生成）
data/memory/
# 日志与安装记录
data/*.log
data/pip_install.log
# 冒烟测试临时目录
data/_smoke_*/

# 后端运行产物（问答缓存库 / 指标库 / 日志，运行时自动生成，不入库）
backend/data/*.db
backend/data/*.db-journal
backend/data/*.db-wal
backend/data/*.db-shm
backend/data/*.log
backend/data/*.log.*

# ---------------------------- AI 协作过程文档（不适合对外展示） ----------------------------
.trae/

# ---------------------------- 编辑器 / 系统杂项 ----------------------------
*.bak
*.tmp
.DS_Store
Thumbs.db

# 搬库 dump 产物：可由 scripts/dump_pg.ps1 随时再生成，靠文件拷贝搬库，不进 git
data/backup/
